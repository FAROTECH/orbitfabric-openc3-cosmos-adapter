{
  "$id": "https://orbitfabric.dev/templates/dummy/profile-0.1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bindings": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "intent": {
                  "const": "do_not_project"
                }
              }
            },
            "then": {
              "required": [
                "reason"
              ]
            }
          }
        ],
        "properties": {
          "config": {
            "additionalProperties": false,
            "properties": {
              "target_name": {
                "minLength": 1,
                "type": "string"
              }
            },
            "type": "object"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "intent": {
            "enum": [
              "project",
              "do_not_project"
            ]
          },
          "reason": {
            "minLength": 1,
            "type": "string"
          },
          "sources": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "domain": {
                  "const": "telemetry"
                },
                "id": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "domain",
                "id"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "id",
          "intent",
          "sources"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "integration": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "orbitfabric-dummy"
        },
        "schema_version": {
          "const": "0.1-candidate"
        }
      },
      "required": [
        "id",
        "schema_version"
      ],
      "type": "object"
    },
    "kind": {
      "const": "orbitfabric.projection_profile"
    },
    "profile": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "type": "object"
    },
    "profile_version": {
      "const": "0.1-candidate"
    },
    "settings": {
      "additionalProperties": false,
      "properties": {
        "target_prefix": {
          "default": "DUMMY_",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "kind",
    "profile_version",
    "profile",
    "integration",
    "settings",
    "bindings"
  ],
  "title": "OrbitFabric Dummy Adapter Projection Profile",
  "type": "object"
}
